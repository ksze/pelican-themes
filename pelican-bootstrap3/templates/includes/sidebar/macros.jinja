{% macro title(name, no_icon, icon='home') -%}
  {%- if no_icon -%}
    {{ name }}
  {%- else -%}
    {%- if icon in ["github", "twitter"] -%}
      <i class="fab fa-{{ icon }} fa-lg"></i><span class="icon-label">{{ name }}</span>
    {%- else -%}
      <i class="fa fa-{{ icon }} fa-lg"></i><span class="icon-label">{{ name }}</span>
    {%- endif -%}
  {%- endif -%}
{%- endmacro %}
